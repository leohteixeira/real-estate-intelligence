# Copy this file to .env before running `docker compose up`.
#
# It is named `env.example` and not `.env.example` on purpose: the workspace
# `.claudeignore` excludes every `.env.*` path, which would make the example
# unreadable to the assistants configured for this portfolio.
#
# Never put a real credential in this file.

# --- PostgreSQL / PostGIS ---------------------------------------------------
POSTGRES_DB=real_estate_intelligence
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate
POSTGRES_PORT=5434

# Consumed by the API, by the worker and by scripts/migrate.sh.
DATABASE_URL=postgres://realestate:realestate@postgres:5432/real_estate_intelligence

# --- RabbitMQ ---------------------------------------------------------------
# Broker credentials are consumed only by the worker.
RABBITMQ_USER=realestate
RABBITMQ_PASSWORD=realestate
RABBITMQ_VHOST=real-estate-intelligence
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://realestate:realestate@rabbitmq:5672/real-estate-intelligence

# --- Application ------------------------------------------------------------
NODE_ENV=development
API_PORT=8200
WEB_PORT=3200
AI_PORT=4111
VITE_API_BASE_URL=http://localhost:8200
# Optional landing page links. Leave empty until a public demo or repository exists.
VITE_DEMO_URL=
VITE_REPOSITORY_URL=

# --- Worker -----------------------------------------------------------------
WORKER_INTERVAL_MS=30000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=25
OUTBOX_CLAIM_LEASE_MS=130000
RABBITMQ_RECONNECT_INTERVAL_MS=1000
WORKER_OPERATION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
EVENT_DELIVERY_LIMIT=5
EVENT_REDELIVERY_DELAY_MS=1000
EVENT_HANDLER_TIMEOUT_MS=120000
BROKER_DRAIN_TIMEOUT_MS=10000
COLLECTION_SCHEDULE_INTERVAL_MS=1000
COLLECTION_SCHEDULE_BATCH_SIZE=10
COLLECTION_CONCURRENCY=2
COLLECTION_RUN_TIMEOUT_MS=115000
SYNTHETIC_PAGE_DELAY_MS=0
OUTBOX_RETENTION_MS=604800000
INBOX_RETENTION_MS=2592000000
DELIVERY_RETENTION_INTERVAL_MS=300000
DELIVERY_RETENTION_BATCH_SIZE=1000

# --- Observability ----------------------------------------------------------
# Leave empty to keep OpenTelemetry instrumentation on without exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Overrides the service name reported in traces and metrics.
OTEL_SERVICE_NAME=

# --- Storage ----------------------------------------------------------------
VALKEY_PORT=6380
MINIO_ROOT_USER=realestate
MINIO_ROOT_PASSWORD=realestate
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=real-estate-snapshots
OBJECT_STORE_ACCESS_KEY_ID=realestate
OBJECT_STORE_SECRET_ACCESS_KEY=realestate
COLLECTION_DEADLINE_MS=30000
