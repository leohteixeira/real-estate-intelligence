# Copy this file to .env before running `docker compose up`.
#
# It is named `env.example` and not `.env.example` on purpose: the workspace
# `.claudeignore` excludes every `.env.*` path, which would make the example
# unreadable to the assistants configured for this portfolio.
#
# Never put a real credential in this file.

# --- PostgreSQL / PostGIS ---------------------------------------------------
POSTGRES_DB=real_estate_intelligence
POSTGRES_USER=realestate
POSTGRES_PASSWORD=realestate
POSTGRES_PORT=5434

# Consumed by the API, by the worker and by scripts/migrate.sh.
DATABASE_URL=postgres://realestate:realestate@postgres:5432/real_estate_intelligence

# --- Application ------------------------------------------------------------
NODE_ENV=development
API_PORT=8200
WEB_PORT=3200
AI_PORT=4111
VITE_API_BASE_URL=http://localhost:8200

# --- Worker -----------------------------------------------------------------
WORKER_INTERVAL_MS=30000
SHUTDOWN_TIMEOUT_MS=15000

# --- Observability ----------------------------------------------------------
# Leave empty to keep OpenTelemetry instrumentation on without exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Overrides the service name reported in traces and metrics.
OTEL_SERVICE_NAME=

# --- Optional services (compose profile `optional`) -------------------------
VALKEY_PORT=6380
MINIO_ROOT_USER=realestate
MINIO_ROOT_PASSWORD=realestate
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
