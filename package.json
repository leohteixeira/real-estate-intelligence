{
  "name": "real-estate-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.19.0",
    "pnpm": "^11.22.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint . && node scripts/check-context-boundaries.mjs && node scripts/check-migration-conventions.mjs",
    "test": "pnpm -r test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:integration": "node integration/audit-tracer.integration.mjs",
    "test:integration:collection": "node integration/synthetic-collection.integration.mjs",
    "test:integration:properties": "node integration/properties-contracts.integration.mjs",
    "test:integration:locations": "node integration/locations.integration.mjs",
    "test:integration:properties-ingestion": "node integration/properties-ingestion.integration.mjs",
    "test:integration:properties-history": "node integration/properties-history.integration.mjs && node integration/properties-history-upgrade.integration.mjs",
    "test:integration:snapshot-lifecycle": "node integration/snapshot-lifecycle.integration.mjs",
    "test:integration:snapshot-reparse": "node integration/snapshot-reparse.integration.mjs",
    "test:integration:resumable-collection": "node integration/resumable-collection.integration.mjs",
    "test:integration:scheduled-collection": "node integration/scheduled-collection.integration.mjs",
    "test:integration:collection-resilience": "node integration/collection-resilience.integration.mjs",
    "test:integration:source-register": "node --test integration/source-register-cleanup.test.mjs && node integration/source-register.integration.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "amqplib": "0.10.9",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
