{
  "name": "real-estate-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.19.0",
    "pnpm": "^11.22.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint . && node scripts/check-context-boundaries.mjs && node scripts/check-migration-conventions.mjs",
    "test": "pnpm -r test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "test:integration:list": "vitest list --config vitest.integration.config.ts",
    "test:integration:audit": "vitest run --config vitest.integration.config.ts integration/audit-tracer.integration.test.ts",
    "test:integration:healthcheck": "vitest run --config vitest.integration.config.ts integration/rabbitmq-healthcheck.integration.test.ts",
    "test:integration:collection": "vitest run --config vitest.integration.config.ts integration/synthetic-collection.integration.test.ts",
    "test:integration:properties": "vitest run --config vitest.integration.config.ts integration/properties-contracts.integration.test.ts",
    "test:integration:locations": "vitest run --config vitest.integration.config.ts integration/locations.integration.test.ts",
    "test:integration:market": "vitest run --config vitest.integration.config.ts integration/market-contracts.integration.test.ts",
    "test:integration:ask": "vitest run --config vitest.integration.config.ts integration/ask-contracts.integration.test.ts",
    "test:integration:ask-tracer": "vitest run --config vitest.integration.config.ts integration/ask-price-run.integration.test.ts",
    "test:integration:ask-text-price": "vitest run --config vitest.integration.config.ts integration/ask-text-price-run.integration.test.ts",
    "test:integration:ask-model-explanation": "vitest run --config vitest.integration.config.ts integration/ask-model-explanation.integration.test.ts",
    "test:integration:ask-checkpoints": "vitest run --config vitest.integration.config.ts integration/ask-checkpoints.integration.test.ts",
    "test:integration:ask-delivery": "vitest run --config vitest.integration.config.ts integration/ask-delivery.integration.test.ts",
    "test:integration:run-executor": "vitest run --config vitest.integration.config.ts integration/run-executor.integration.test.ts",
    "run:foundation": "pnpm --filter @rei/worker run:foundation",
    "test:integration:market-median": "vitest run --config vitest.integration.config.ts integration/market-median.integration.test.ts",
    "test:integration:market-price-facts": "vitest run --config vitest.integration.config.ts integration/market-price-facts.integration.test.ts",
    "test:integration:properties-ingestion": "vitest run --config vitest.integration.config.ts integration/properties-ingestion.integration.test.ts",
    "test:integration:properties-history": "vitest run --config vitest.integration.config.ts integration/properties-history.integration.test.ts integration/properties-history-upgrade.integration.test.ts",
    "test:integration:listing-provenance": "vitest run --config vitest.integration.config.ts integration/listing-provenance.integration.test.ts",
    "test:integration:snapshot-lifecycle": "vitest run --config vitest.integration.config.ts integration/snapshot-lifecycle.integration.test.ts",
    "test:integration:snapshot-reparse": "vitest run --config vitest.integration.config.ts integration/snapshot-reparse.integration.test.ts",
    "test:integration:resumable-collection": "vitest run --config vitest.integration.config.ts integration/resumable-collection.integration.test.ts",
    "test:integration:scheduled-collection": "vitest run --config vitest.integration.config.ts integration/scheduled-collection.integration.test.ts",
    "test:integration:collection-resilience": "vitest run --config vitest.integration.config.ts integration/collection-resilience.integration.test.ts",
    "test:integration:source-register": "vitest run --config vitest.integration.config.ts integration/source-register-cleanup.test.ts integration/source-register.integration.test.ts",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:integration",
    "typecheck:integration": "tsc --project tsconfig.integration.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/amqplib": "0.10.8",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "amqplib": "0.10.9",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "execa": "10.1.0",
    "get-port": "7.2.0",
    "globals": "17.11.0",
    "markdownlint-cli2": "0.22.1",
    "nock": "15.0.1",
    "prettier": "3.8.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
