# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# Environment: only the checked-in example file is tracked
.env
.env.*
!env.example

# Tooling
.DS_Store
*.log

# BMad: the personal configuration layer stays local; team layers are tracked
_bmad/custom/*.user.toml

# Generated browser evidence stays local; keep review reports and design configuration.
/apps/web/.impeccable/review/**
!/apps/web/.impeccable/review/**/
!/apps/web/.impeccable/review/**/*.md
