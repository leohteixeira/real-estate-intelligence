{
  "name": "@rei/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "start": "node -r ./dist/otel.js dist/main.js",
    "collect:synthetic": "node -r ./dist/otel.js dist/collection/collect-synthetic.js",
    "collect:resumable": "node -r ./dist/otel.js dist/collection/collect-resumable.js",
    "snapshot:reparse": "node -r ./dist/otel.js dist/collection/reparse-snapshot.js",
    "source:enable": "node -r ./dist/otel.js dist/collection/enable-source.js",
    "typecheck": "tsc --build --force",
    "test": "vitest run --dir src --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/resilience": "0.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@rei/application": "workspace:*",
    "@rei/domain": "workspace:*",
    "@rei/infrastructure": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
