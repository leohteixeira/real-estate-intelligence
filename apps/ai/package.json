{
  "name": "@rei/ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node -r ./dist/otel.js dist/main.js",
    "check:keys": "node --env-file=../../.env scripts/check-provider-keys.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir src --passWithNoTests",
    "probe:intent": "node scripts/probe-intent-decision.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.94",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/resilience": "0.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@rei/contracts": "workspace:*",
    "@rei/domain": "workspace:*",
    "ai": "7.0.137",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
